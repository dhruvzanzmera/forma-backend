# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/ecommerce_db

# Security & JWT
JWT_SECRET=super_secret_jwt_key_ecommerce_backend_2026_secure
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000

# Cloudinary image storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Super Admin Seeder Credentials
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@12345
ADMIN_PHONE=9876543210

# Email Configuration
# Recommended on Render: use Resend's HTTPS API; set an API key and a verified sender.
RESEND_API_KEY=
EMAIL_FROM='"E-Commerce Store" <no-reply@your-verified-domain.com>'

# Optional SMTP configuration for hosts that permit outbound SMTP.
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=

# Business Logic Configuration
OTP_EXPIRE_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
MAX_FILE_SIZE_MB=5
TAX_RATE_PERCENTAGE=5
SHIPPING_FEE=50
FREE_SHIPPING_THRESHOLD=1000
